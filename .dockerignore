# Keep the linux-replay build context hermetic and small. The Dockerfile only
# needs source + replaydata fixtures; exclude host build output, deps, and VCS
# so the image is identical across dev machines and CI's clean checkout.
.git
.build
**/node_modules
**/.build
platforms/macos/.build
*.dmg
*.pkg
*.tar.gz
.claude/worktrees

# examples/relay/Dockerfile bakes the dashboard in with `COPY platforms/web/`
# — a directory copy, because the enumeration it replaced fell behind the
# module graph and served a dashboard that 404'd its own imports. The filter
# therefore has to run the other way: name the dev-only files here so the
# image carries the runtime tree and nothing else. Scoped to platforms/web
# rather than global — the onboarding viewer's web tree has the same file
# names and is not in any image's context.
platforms/web/*.test.js
platforms/web/*.testutil.js
platforms/web/snapshots
platforms/web/package.json
platforms/web/package-lock.json
platforms/web/vitest.config.js
platforms/web/vitest.setup.js

# Never let local secrets ride along on a recursive COPY (SonarQube
# docker:S6470) — .env holds SONAR_TOKEN and friends and is gitignored, so it
# exists on disk for plenty of contributors even though it's untracked.
.env
.env.*
!.env.example

# platforms/web/.gitignore is a dev-only file that a directory COPY otherwise
# serves from the image root.
platforms/web/.gitignore
