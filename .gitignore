*~

# OS generated files
Thumbs.db
ehthumbs.db

# Gas Town (added by gt)
.runtime/
.claude/worktrees/
# Per-machine Claude Code permission grants — never belongs in a commit.
# Only ~/.config/git/ignore covered this, which doesn't travel to other clones,
# so ir:exec step 11b's `git add -A` would sweep it into the implementation commit.
.claude/settings.local.json
.logs/
__pycache__/
state.json
# Allow gastown scenario fixtures (daemon/state.json) under replaydata.
!replaydata/orchestrators/**/input/daemon/state.json
.beads/

# Replay harness — fixtures are committed as regression data; reports are
# regenerated locally by tools/replay-fixtures.sh.
replaydata/agents/_reports/
.pi
.specs
.aider*
# OpenCode session metadata (auto-created by the daemon)
opencode.json
/expected-validate

**/*.env
# Scratch dir used by atomic_promote while a candidate recording is validated;
# it lives inside replaydata/ and `record` commits that tree with a directory add.
.promote-tmp*

# Stray dev binary: `go build ./tools/beacon-drive/...` from the repo root
# drops it here. The rig builds it into .build/beacon-rig instead.
/beacon-drive
